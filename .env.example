# ============================================================================
# server/.env.example — template for every env var the server reads.
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored,
# so git never sees credentials. On a platform site (e.g. Render), env vars
# set in the dashboard OVERRIDE this file — dotenv never overwrites real
# environment variables.
# ============================================================================

# --- Server configuration ------------------------------------------------
DEVELOPMENT_PORT=8000
# Allowed origins for CORS. NOTE: verify which is "deploy" vs "local";
# the names have been swapped in some past commits.
DEPLOY_CLIENT_ORG=http://localhost:5173
LOCAL_CLIENT_ORG=https://abang-suizo-is.netlify.app/
NODE_ENV=development

# Default password assigned to seeded users (login password, NOT a DB password).
DEFAULT_PASSWORD=12345

# --- Source database (MySQL) ---------------------------------------------
# The database that `migrate_all.mjs`, `migrate_to_tidb.mjs` and the app read.
# PORT MATTERS: TiDB Cloud listens on 4000 — a wrong port fails at handshake.
# TLS: `migrate_all.mjs` (run automatically by `npm start`) enables SSL when
# NODE_ENV=production, matching src/config/database.ts. Required for TiDB Cloud.
DB_NAME=gradesync
DB_PORT=3306
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=

# --- TiDB target (used by `npm run migrate:tidb`) -------------------------
# Host/port/user/database are required. TIDB_PASSWORD falls back to
# DEFAULT_PASSWORD, then to an empty password. Pass --require-password to
# abort instead of using a fallback. The value is never logged.
#
# If the target credentials live under DB_* in another file (e.g. the
# production snapshot `gradeSync-server-side.env`), run:
#   node migrate_to_tidb.mjs --target-env=gradeSync-server-side.env
# which maps that file's DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME to the
# TIDB_* target, overriding any TIDB_* values from the CWD .env. Alias: TIDB_ENV_FILE.
TIDB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=<cluster>.root
TIDB_PASSWORD=
TIDB_DATABASE=gradesync
TIDB_SSL=1

# --- JWT ------------------------------------------------------------------
JWT_SECRET=login-secret-key

# --- File uploads (developer-only POST /api/uploads) ----------------------
# Directory where uploaded landing-page images are stored (created on demand).
# Git-ignored. Use an absolute path in production; relative paths resolve
# against the server's working directory.
UPLOAD_DIR=./uploads

# Public origin of THIS server, used to build absolute URLs for uploaded
# files (the client runs on a different origin). No trailing slash.
SERVER_ORIGIN=http://localhost:8000