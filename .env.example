# --- Server configuration ------------------------------------------------
DEVELOPMENT_PORT=8000
# Allowed origins for CORS. NOTE: verify which is "deploy" vs "local";
# the names have been swapped in some past commits.
DEPLOY_CLIENT_ORG=http://localhost:5173
# No trailing slash: browsers never send one on the Origin header.
LOCAL_CLIENT_ORG=https://abang-suizo-is.netlify.app
NODE_ENV=development

# Default password assigned to seeded users (login password, NOT a DB password).
# REQUIRED before `npm run seed` — set your own strong value. The old committed
# default (12345) was a real, guessable password and has been removed.
DEFAULT_PASSWORD=replace-with-a-strong-temporary-password

# --- Source database (MySQL) ---------------------------------------------
DB_NAME=gradesync
DB_PORT=3306
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=

# --- JWT ------------------------------------------------------------------
# REQUIRED. Signing key for login tokens. Generate a long random value, e.g.
#   openssl rand -hex 32
# and keep the real value in your local .env (never commit it). The old
# committed default (login-secret-key) was a real, guessable secret and has
# been removed.
JWT_SECRET=replace-with-a-long-random-secret

# --- File uploads (developer-only POST /api/uploads) ----------------------
UPLOAD_DIR=./uploads

# --- Honor students -------------------------------------------------------
# Minimum average (0-100) a student in the adviser's class needs to be listed
# as an honor student. Defaults to 85 when unset.
HONOR_STUDENT_PASSING_GRADE=85

# --- Server-side cache (lru-cache) ----------------------------------------
# Maximum number of cached read responses and their default lifetime in
# milliseconds. Both default to 500 entries / 60000 ms (1 minute).
CACHE_MAX_ENTRIES=500
CACHE_TTL_MS=60000