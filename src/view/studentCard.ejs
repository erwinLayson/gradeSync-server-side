    <style>
      @page {
        size: 13in 8.5in;
        margin: 0;
      }

      :root {
        --font-xs: 8px;
        --font-sm: 10pt;
        --font-md: 12pt;
      }

      body {
        padding: 0;
        margin: 0;
        font-family: "Times New Roman", Times, serif;
      }

      .text-xs {
        font-size: var(--font-xs);
      }

      .text-sm {
        font-size: var(--font-sm);
      }

      .text-md {
        font-size: var(--font-md);
      }

      table {
        border-collapse: collapse;
        width: 100%;
        font-size: var(--font-sm);
      }

      td,
      th {
        padding: 0 5px;
        border: 1.5px solid black;
      }

      .p-md {
        padding: 5px 10px;
      }

      .attendance-table {
        width: 100%;
        table-layout: fixed;
      }
    </style>
